rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function tenantIdClaim() {
      return request.auth.token.tenantId;
    }

    function belongsToTenant(tenantId) {
      return isSignedIn() && tenantIdClaim() == tenantId;
    }

    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.platformAdmin == true;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    // ---------- users/{uid} ----------
    // Admin-SDK-only writes. Users read their own doc.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- userTenantMemberships/{uid}_{tenantId} ----------
    // Admin-SDK-only writes. User reads their own rows (docId prefix match).
    match /userTenantMemberships/{membershipId} {
      allow read: if isSignedIn()
        && membershipId.matches(request.auth.uid + "_.*");
      allow write: if false;
    }

    // ---------- signups/{uid} ----------
    // One record per self-signup (A-12). onSignup creates it in the same
    // transaction as the tenant, so a double submit can't create two tenants.
    // Admin-SDK only.
    match /signups/{uid} {
      allow read: if false;
      allow write: if false;
    }

    // ---------- signInLinkLimits/{emailHash} ----------
    // Per-address limit on portal sign-in link emails (E-01). Cloud Functions
    // only; removed by the TTL policy on `expireAt`.
    match /signInLinkLimits/{emailHash} {
      allow read: if false;
      allow write: if false;
    }

    // ---------- customDomains/{domain} ----------
    match /customDomains/{domain} {
      allow read: if false;
      allow write: if false;
    }

    // ---------- stripeAccounts/{stripeAccountId} ----------
    match /stripeAccounts/{accountId} {
      allow read: if false;
      allow write: if false;
    }

    // ---------- stripeEvents/{eventId} ----------
    // Webhook idempotency sentinel — written by Cloud Functions only.
    // 30-day TTL via Firestore TTL policy on `expireAt`.
    match /stripeEvents/{eventId} {
      allow read: if false;
      allow write: if false;
    }

    // ---------- emailSends/{keyHash} ----------
    // Email idempotency sentinel (D5) — written by Cloud Functions only.
    // 30-day TTL via Firestore TTL policy on `expireAt`.
    match /emailSends/{keyHash} {
      allow read: if false;
      allow write: if false;
    }

    // ---------- platformAdmins/{uid} ----------
    match /platformAdmins/{uid} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // ---------- tenants/{tenantId} ----------
    match /tenants/{tenantId} {

      // meta/settings — readable by members; public read for customer portal handled via dedicated endpoint (Phase 3+).
      match /meta/{docId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if false;
      }

      match /entitlements/{docId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if false;
      }

      match /counters/{counterId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if false;
      }

      match /customers/{customerId} {
        // Tenant members (staff) read all. Customer portal uses separate dual-read via
        // collection-group query guarded by email match — see Phase 2 callable fallback.
        allow read: if belongsToTenant(tenantId);
        allow write: if false;
      }

      match /invoices/{invoiceId} {
        // Customers read their own invoices once sent — never drafts (A-05).
        // Same list as CUSTOMER_VISIBLE_INVOICE_STATUSES in
        // functions/src/shared/customerVisibility.ts; the rules tests iterate it.
        allow read: if belongsToTenant(tenantId)
          || (emailVerified()
              && resource.data.customer.email.lower() == authEmailLower()
              && resource.data.status in ['sent', 'unpaid', 'overdue', 'partial', 'paid', 'refunded', 'partially-refunded', 'void']);
        allow write: if false;

        // payAttempts — rate-limit ledger for createPayTokenCheckoutSession.
        // Admin-SDK only; never read or written by clients.
        match /payAttempts/{attemptId} {
          allow read: if false;
          allow write: if false;
        }

        // paymentIncidents — audit trail for version-mismatch auto-refunds
        // (C2 guard). Tenant staff may read for support/debugging; writes
        // are admin-SDK only from the Stripe webhook handler.
        match /paymentIncidents/{incidentId} {
          allow read: if belongsToTenant(tenantId);
          allow write: if false;
        }
      }

      match /quotes/{quoteId} {
        // Customers read their own quotes once sent — never drafts (A-05).
        // Same list as CUSTOMER_VISIBLE_QUOTE_STATUSES in
        // functions/src/shared/customerVisibility.ts; the rules tests iterate it.
        allow read: if belongsToTenant(tenantId)
          || (emailVerified()
              && resource.data.customer.email.lower() == authEmailLower()
              && resource.data.status in ['sent', 'accepted', 'declined', 'expired', 'converted']);
        allow write: if false;
      }

      match /recurringInvoices/{recurringId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if false;
      }

      match /invitations/{invitationId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if false;
      }
    }

    // ---------- Collection-group customer portal reads ----------
    // Deferred to Phase 2 callable (getCustomerInvoicesByEmail / getCustomerQuotesByEmail).
    // Placeholder stub intentionally left commented — do not enable without rules-unit tests.
    // match /{path=**}/invoices/{invoiceId} {
    //   allow read: if emailVerified()
    //     && resource.data.customer.email.lower() == authEmailLower();
    // }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
